+describe("browser save", () => {
+  it("reads back the newest value while its write is still in flight", async () => {
+    const done = saveSchool('{"sections":["new class"]}');
+    expect(await readSchool()).toBe('{"sections":["new class"]}');
+    await done;
+    expect(await readSchool()).toBe('{"sections":["new class"]}');
