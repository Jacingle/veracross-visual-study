+  const setRequired = (ids: string[], on: boolean) => update((s) => ({ ...s, scheduleReview: { ...s.scheduleReview, required: { ...s.scheduleReview?.required, ...Object.fromEntries(ids.map((id) => [id, on])) } } }));
